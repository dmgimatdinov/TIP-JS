{
  "name": "tip-js-lecture-06-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/store-postgres.js && node --check src/query-builders.js && node --check src/db.js && node --check src/config.js",
    "test": "node --test \"checks/server.test.js\" \"checks/query-builders.test.js\"",
    "check:db": "node --test checks/database.test.js",
    "check:queries": "psql -X -h 127.0.0.1 -U tip_app -d tip_tasks -v ON_ERROR_STOP=1 -f sql/03_queries.sql"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
